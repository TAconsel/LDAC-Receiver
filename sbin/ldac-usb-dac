#!/bin/bash
# Play what the USB host sends into the same room correction and the same
# interface the Bluetooth path uses.
#
#   ldac-usb-dac run           wait for a host, then run CamillaDSP (for the unit)
#   ldac-usb-dac write-config  just emit the generated config, for inspection
#
# The filters are NOT duplicated here.  This takes everything from `filters:`
# onwards out of the *installed* /etc/camilladsp/roomcorr.yaml and puts a USB
# `devices:` block in front of it, which is the same trick tools/verify-
# convolution.sh uses.  So both sources get provably the same correction, the
# same 2->4 mixer and the same uncorrected recorder tap on outputs 3-4, and
# there is only one file to edit when the filter changes.
#
# SPDX-License-Identifier: MIT

set -euo pipefail

CONFIG="${CONFIG:-/etc/camilladsp/roomcorr.yaml}"
CAMILLADSP="${CAMILLADSP:-/usr/local/bin/camilladsp}"
OUT="${OUT:-/run/camilladsp/usb.yaml}"
DEFAULTS="${DEFAULTS:-/etc/default/ldac-receiver}"
CARD="${CARD:-U192k}"
GADGET_CARD="${GADGET_CARD:-UAC2Gadget}"
RATE="${RATE:-96000}"

# The room correction is a setting shared with the Bluetooth path: LDAC_PCM is
# `dsp96` for corrected and `ldac96` for bypassed.  Rather than invent a second
# switch, this reads the same one, so the panel's single toggle means the same
# thing whichever input is selected.
#
# Bypass still goes through CamillaDSP rather than straight to the card, because
# the rate matching below is needed either way.  It plays into the `ldac96` ALSA
# device, whose ttable already widens stereo to the interface's four outputs and
# feeds the recorder tap -- so the bypassed path needs no mixer and no filters
# here, and there is nothing to keep in sync.

# CamillaDSP sizes both ALSA buffers from the chunk, so this is the knob for
# both latency and slack: the playback buffer comes out at 4x the chunk, and the
# level it is held at (target_level below) at 2x.  2048 gives an 8192 frame
# buffer held at 4096, so ~21 ms of chunk plus ~43 ms of fill.
#
# It also makes the convolution cheaper -- 32768 taps over 4096-sample
# partitions is 8 segments instead of 16 -- and costs latency, which for a music
# receiver already carrying a 45 ms linear-phase filter is not the binding
# constraint.
#
# The capture side cannot follow it up: u_audio fixes the gadget's buffer at
# 8192 frames with a 512 frame period (prealloc_max is 64 KB and writing it
# changes nothing), so CamillaDSP asks for 16384 there, is refused, and settles
# for 8192 -- two chunks.  That is the reason not to go higher than 4096.
#
# Tunable without editing this file: set LDAC_CHUNKSIZE in /etc/default/ldac-
# receiver and restart. Halving it halves the buffer latency and doubles how
# often the uncorrected drift empties the buffer, so it trades a tick every so
# often against responsiveness. Keep it a power of two, and no lower than 1024:
# below that the 32768 tap filter needs 32+ segments and the period drops under
# 11 ms, which is where the scheduler starts to matter again.
CHUNKSIZE="${CHUNKSIZE:-}"
if [[ -z $CHUNKSIZE && -f $DEFAULTS ]]; then
	# shellcheck disable=SC1090
	CHUNKSIZE=$(. "$DEFAULTS" 2>/dev/null; echo "${LDAC_CHUNKSIZE:-}")
fi
CHUNKSIZE="${CHUNKSIZE:-2048}"

# How full CamillaDSP keeps the interface's playback buffer.  CamillaDSP's
# default is one chunk, which leaves nothing to absorb a late write; two chunks
# is the level the rate correction then holds it at, so it is half the buffer
# and there is as much room to drain into as to grow into.  Scaled with the
# chunk rather than fixed, so changing one does not silently unbalance the other.
TARGET_LEVEL="${TARGET_LEVEL:-$((CHUNKSIZE * 2))}"

# Chunks allowed to sit between the capture and playback threads.  1 is the
# lowest latency and leaves the playback thread nothing to fall back on when it
# is late; CamillaDSP's own default is 4, which is ~85 ms of slack here and the
# difference between riding over a scheduling hiccup and clicking.
QUEUELIMIT="${QUEUELIMIT:-4}"

die() { echo "ldac-usb-dac: $*" >&2; exit 1; }

# How the drift between the host's clock and the interface's gets corrected.
#
# NOT with the gadget's "Capture Pitch 1000000" control, even though u_audio
# offers one and CamillaDSP will happily drive it when enable_rate_adjust is on.
# Measured on this board: force the pitch to 1005000 (+5000 ppm) and record the
# capture device, and the recording comes back with a 1.00 ms hole every 200 ms
# -- 116 of them in 25 s, which is exactly 5000 ppm expressed as inserted
# silence.  u_audio implements the pitch by punching holes in the stream rather
# than by scaling what the feedback endpoint reports, so *any* correction it
# applies is audible as a skip, and CamillaDSP cannot see it happening because
# the kernel does it below the capture device.  Even the +30 ppm steady state
# this settles at is a 1 ms gap every 33 seconds.
#
# So there are two usable modes:
#
#   none      let the endpoint's own async feedback be the only loop and accept
#             that a slow drift eventually empties the buffer.  With a 171 ms
#             playback buffer and tens of ppm of drift that is one underrun
#             every tens of minutes -- a single tick, against a hole every half
#             minute.  This is the default.
#   resample  absorb the drift inside CamillaDSP with an async resampler.  Only
#             reachable when the capture device has no pitch control, because
#             CamillaDSP prefers the device's own mechanism when one exists.
#
# LDAC_DRIFT_MODE overrides, mostly so the pitch behaviour can be re-measured
# without editing this file.
drift_mode() {
	local forced
	# shellcheck disable=SC1090
	[[ -f $DEFAULTS ]] && forced=$(. "$DEFAULTS" 2>/dev/null; echo "${LDAC_DRIFT_MODE:-}")
	if [[ -n ${forced:-} ]]; then echo "$forced"; return; fi
	if [[ $(cat /sys/kernel/config/usb_gadget/ldacrx/functions/uac2.usb0/c_sync \
		2>/dev/null) == async ]]; then
		echo none
	else
		echo resample
	fi
}

corrected() {
	local pcm=dsp96
	# shellcheck disable=SC1090
	[[ -f $DEFAULTS ]] && pcm=$(. "$DEFAULTS" 2>/dev/null; echo "${LDAC_PCM:-dsp96}")
	[[ $pcm != ldac96 ]]
}

write_config() {
	mkdir -p "$(dirname "$OUT")"

	# Emitted into both configs below, so the running file explains itself.
	case "$(drift_mode)" in
	pitch)
		RATE_ADJUST_BLOCK=$(cat <<'YAML'
  # Drives the gadget's Capture Pitch control. Kept only so the behaviour can be
  # re-measured: on this board u_audio implements pitch as inserted silence, one
  # 1 ms hole per 200 ms at 5000 ppm, so this is audible. Do not use it.
  enable_rate_adjust: true
  adjust_period: 60
YAML
		)
		;;
	none)
		RATE_ADJUST_BLOCK=$(cat <<'YAML'
  # Async endpoint and no pitch control: the hardware feedback loop is already
  # closed through this process, and a second one here would fight it.
  enable_rate_adjust: false
YAML
		)
		;;
	*)
		RATE_ADJUST_BLOCK=$(cat <<YAML
  # Adaptive endpoint and no pitch control: the host free-runs at its own idea
  # of $RATE Hz while the UMC404HD consumes at its own, so the tens of ppm
  # between the two crystals has to be absorbed here.
  enable_rate_adjust: true
  adjust_period: 10
  resampler:
    type: AsyncSinc
    profile: Balanced
YAML
		)
		;;
	esac

	if ! corrected; then
		cat > "$OUT" <<-EOF
		# Generated by ldac-usb-dac.  Room correction is switched off, so this
		# only matches the host's clock to the interface's and hands the result
		# to the ldac96 ALSA device, which widens stereo to four outputs.
		devices:
		  samplerate: $RATE
		  capture_samplerate: $RATE
		  chunksize: $CHUNKSIZE
		  target_level: $TARGET_LEVEL
		  queuelimit: $QUEUELIMIT
$RATE_ADJUST_BLOCK
		  capture:
		    type: Alsa
		    channels: 2
		    device: "hw:$GADGET_CARD,0"
		    format: S32LE
		  playback:
		    type: Alsa
		    channels: 2
		    device: "ldac96"
		    format: S32LE
		EOF
		return
	fi

	[[ -f $CONFIG ]] || die "no such config: $CONFIG"
	grep -q '^filters:' "$CONFIG" || die "no 'filters:' section in $CONFIG"
	{
		cat <<-EOF
		# Generated by ldac-usb-dac from $CONFIG.  Do not edit: it is
		# rewritten on every start.  Edit $CONFIG instead.
		devices:
		  samplerate: $RATE
		  capture_samplerate: $RATE
		  chunksize: $CHUNKSIZE
		  target_level: $TARGET_LEVEL
		  queuelimit: $QUEUELIMIT
$RATE_ADJUST_BLOCK
		  capture:
		    type: Alsa
		    channels: 2
		    device: "hw:$GADGET_CARD,0"
		    format: S32LE
		  playback:
		    type: Alsa
		    channels: 4
		    device: "hw:$CARD,0"
		    format: S32LE
		EOF
		sed -n '/^filters:/,$p' "$CONFIG"
	} > "$OUT"
}

udc_state() {
	# There can be two controllers, and only the one the gadget is bound to says
	# anything useful -- the other sits at "not attached" for ever and, sorting
	# first, would keep this waiting through a perfectly good host session.
	local bound s
	bound=$(cat /sys/kernel/config/usb_gadget/ldacrx/UDC 2>/dev/null) || true
	if [[ -n ${bound:-} && -e /sys/class/udc/$bound/state ]]; then
		cat "/sys/class/udc/$bound/state"
		return
	fi
	for s in /sys/class/udc/*/state; do
		[[ -e $s ]] && { cat "$s"; return; }
	done
	echo "no-udc"
}

wait_for_host() {
	# `configured` means a host has enumerated us and selected a
	# configuration.  Starting CamillaDSP before that just blocks forever on a
	# capture device that will never produce a sample, while holding the
	# UMC404HD open so nothing else can use it.
	local state
	while :; do
		state=$(udc_state)
		[[ $state == configured ]] && return 0
		sleep 2
	done
}

case "${1:-run}" in
write-config)
	write_config
	echo "$OUT"
	;;
run)
	[[ -x $CAMILLADSP ]] || die "no camilladsp at $CAMILLADSP"
	wait_for_host
	write_config
	# CamillaDSP exits when the host stops streaming and the capture device
	# goes away; the unit restarts it and it waits again.
	exec "$CAMILLADSP" "$OUT" -l warn
	;;
*)
	die "usage: ldac-usb-dac run|write-config"
	;;
esac
