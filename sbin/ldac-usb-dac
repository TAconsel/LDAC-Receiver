#!/bin/bash
# Play what the USB host sends into the same room correction and the same
# interface the Bluetooth path uses.
#
#   ldac-usb-dac run           wait for a host, then run CamillaDSP (for the unit)
#   ldac-usb-dac write-config  just emit the generated config, for inspection
#
# The filters are NOT duplicated here.  This takes everything from `filters:`
# onwards out of the *installed* /etc/camilladsp/roomcorr.yaml and puts a USB
# `devices:` block in front of it, which is the same trick tools/verify-
# convolution.sh uses.  So both sources get provably the same correction, the
# same 2->4 mixer and the same uncorrected recorder tap on outputs 3-4, and
# there is only one file to edit when the filter changes.
#
# SPDX-License-Identifier: MIT

set -euo pipefail

CONFIG="${CONFIG:-/etc/camilladsp/roomcorr.yaml}"
CAMILLADSP="${CAMILLADSP:-/usr/local/bin/camilladsp}"
OUT="${OUT:-/run/camilladsp/usb.yaml}"
DEFAULTS="${DEFAULTS:-/etc/default/ldac-receiver}"
CARD="${CARD:-U192k}"
GADGET_CARD="${GADGET_CARD:-UAC2Gadget}"
RATE="${RATE:-96000}"

# The room correction is a setting shared with the Bluetooth path: LDAC_PCM is
# `dsp96` for corrected and `ldac96` for bypassed.  Rather than invent a second
# switch, this reads the same one, so the panel's single toggle means the same
# thing whichever input is selected.
#
# Bypass still goes through CamillaDSP rather than straight to the card, because
# the rate matching below is needed either way.  It plays into the `ldac96` ALSA
# device, whose ttable already widens stereo to the interface's four outputs and
# feeds the recorder tap -- so the bypassed path needs no mixer and no filters
# here, and there is nothing to keep in sync.

# The gadget's capture buffer tops out at 8192 frames with a 512 frame period
# (u_audio fixes this; prealloc_max is 64 KB and cannot be raised), so the
# chunk has to be small enough that CamillaDSP's ALSA buffer fits inside it.
# 2048 frames is 21 ms and leaves the 32768 tap filter at 16 partitions.
CHUNKSIZE="${CHUNKSIZE:-2048}"

# How full CamillaDSP tries to keep the interface's playback buffer.  The
# default is one chunk, which leaves nothing to absorb the first few seconds of
# a stream while the host's feedback loop is still settling -- that showed up as
# a couple of "Prepare playback after buffer underrun" warnings, and a click,
# in the first ~15 s and none afterwards.  Two chunks costs 21 ms of latency and
# still fits inside the card's 8192 frame buffer.
TARGET_LEVEL="${TARGET_LEVEL:-4096}"

die() { echo "ldac-usb-dac: $*" >&2; exit 1; }

# Whether CamillaDSP has to do the clock matching, which depends on which
# endpoint sync type the gadget actually bound with.
#
#   async     the gadget reports its real consumption on a feedback endpoint and
#             the host follows.  The clock loop already exists in hardware, and
#             it is closed through *us*: we drain at the interface's rate,
#             u_audio measures that, the host adjusts.  A second loop here would
#             fight it, so rate adjustment stays off.
#   adaptive  no feedback endpoint, so the host free-runs at its own idea of the
#             rate and the drift has to be absorbed here.
#
# ldac-usb-gadget asks for async and settles for adaptive, so this is read from
# the bound gadget rather than assumed.
rate_adjust_needed() {
	local sync
	sync=$(cat /sys/kernel/config/usb_gadget/ldacrx/functions/uac2.usb0/c_sync \
		2>/dev/null) || return 0
	[[ $sync != async ]]
}

corrected() {
	local pcm=dsp96
	# shellcheck disable=SC1090
	[[ -f $DEFAULTS ]] && pcm=$(. "$DEFAULTS" 2>/dev/null; echo "${LDAC_PCM:-dsp96}")
	[[ $pcm != ldac96 ]]
}

write_config() {
	mkdir -p "$(dirname "$OUT")"

	# Emitted into both configs below.  With async there is nothing to correct
	# here, and saying so in the file makes the running config self-explaining.
	if rate_adjust_needed; then
		RATE_ADJUST_BLOCK=$(cat <<YAML
  # The gadget bound as 'adaptive': no feedback endpoint, so the host free-runs
  # at its own idea of $RATE Hz while the UMC404HD consumes at its own. Tens of
  # ppm between the two crystals would empty or overflow the buffer every few
  # minutes and click. Watch the capture buffer level and trim the resampling
  # ratio to match -- the job an asynchronous USB DAC does in hardware.
  enable_rate_adjust: true
  adjust_period: 10
  resampler:
    type: AsyncSinc
    profile: Balanced
YAML
		)
	else
		RATE_ADJUST_BLOCK=$(cat <<'YAML'
  # The gadget bound as 'async': it reports our real consumption on a feedback
  # endpoint and the host follows, so the clock loop already exists and is
  # closed through this process. A second loop here would fight it, so the
  # samples reach the interface unresampled.
  enable_rate_adjust: false
YAML
		)
	fi

	if ! corrected; then
		cat > "$OUT" <<-EOF
		# Generated by ldac-usb-dac.  Room correction is switched off, so this
		# only matches the host's clock to the interface's and hands the result
		# to the ldac96 ALSA device, which widens stereo to four outputs.
		devices:
		  samplerate: $RATE
		  capture_samplerate: $RATE
		  chunksize: $CHUNKSIZE
		  target_level: $TARGET_LEVEL
		  queuelimit: 1
$RATE_ADJUST_BLOCK
		  capture:
		    type: Alsa
		    channels: 2
		    device: "hw:$GADGET_CARD,0"
		    format: S32LE
		  playback:
		    type: Alsa
		    channels: 2
		    device: "ldac96"
		    format: S32LE
		EOF
		return
	fi

	[[ -f $CONFIG ]] || die "no such config: $CONFIG"
	grep -q '^filters:' "$CONFIG" || die "no 'filters:' section in $CONFIG"
	{
		cat <<-EOF
		# Generated by ldac-usb-dac from $CONFIG.  Do not edit: it is
		# rewritten on every start.  Edit $CONFIG instead.
		devices:
		  samplerate: $RATE
		  capture_samplerate: $RATE
		  chunksize: $CHUNKSIZE
		  target_level: $TARGET_LEVEL
		  queuelimit: 1
$RATE_ADJUST_BLOCK
		  capture:
		    type: Alsa
		    channels: 2
		    device: "hw:$GADGET_CARD,0"
		    format: S32LE
		  playback:
		    type: Alsa
		    channels: 4
		    device: "hw:$CARD,0"
		    format: S32LE
		EOF
		sed -n '/^filters:/,$p' "$CONFIG"
	} > "$OUT"
}

udc_state() {
	# There can be two controllers, and only the one the gadget is bound to says
	# anything useful -- the other sits at "not attached" for ever and, sorting
	# first, would keep this waiting through a perfectly good host session.
	local bound s
	bound=$(cat /sys/kernel/config/usb_gadget/ldacrx/UDC 2>/dev/null) || true
	if [[ -n ${bound:-} && -e /sys/class/udc/$bound/state ]]; then
		cat "/sys/class/udc/$bound/state"
		return
	fi
	for s in /sys/class/udc/*/state; do
		[[ -e $s ]] && { cat "$s"; return; }
	done
	echo "no-udc"
}

wait_for_host() {
	# `configured` means a host has enumerated us and selected a
	# configuration.  Starting CamillaDSP before that just blocks forever on a
	# capture device that will never produce a sample, while holding the
	# UMC404HD open so nothing else can use it.
	local state
	while :; do
		state=$(udc_state)
		[[ $state == configured ]] && return 0
		sleep 2
	done
}

case "${1:-run}" in
write-config)
	write_config
	echo "$OUT"
	;;
run)
	[[ -x $CAMILLADSP ]] || die "no camilladsp at $CAMILLADSP"
	wait_for_host
	write_config
	# CamillaDSP exits when the host stops streaming and the capture device
	# goes away; the unit restarts it and it waits again.
	exec "$CAMILLADSP" "$OUT" -l warn
	;;
*)
	die "usage: ldac-usb-dac run|write-config"
	;;
esac
