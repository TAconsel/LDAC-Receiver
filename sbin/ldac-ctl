#!/usr/bin/env python3
"""Privileged control surface for the LDAC receiver.

This is the trust boundary between the web control panel and the system.  The
panel runs unprivileged and may only run *this* script through sudo, so every
privileged action the panel can perform is one of the verbs below, with its
arguments validated here.  Nothing takes a free-form command, a path, or a shell
string, and no subprocess is ever run through a shell.

Verbs:
    status                      everything the panel displays, as JSON
    convolution on|off          route Bluetooth audio through CamillaDSP or not
    discoverable on|off         adapter visibility, persisted across reboots
    volume set DB               interface output level, in dB (<= 0)
    volume mute on|off          interface output mute
    volume source panel|device  who drives the interface's volume control
    device connect|disconnect|trust|untrust|remove MAC
    apply-boot                  restore the persisted state at boot
    watch-single-link           run in the foreground, holding the receiver to
                                one connected device at a time

SPDX-License-Identifier: MIT
"""

import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

DEFAULTS = "/etc/default/ldac-receiver"
BLUETOOTH_STATE = "/var/lib/bluetooth"
CARD = os.environ.get("LDAC_CARD", "U192k")
CDSP_CONFIG = "/etc/camilladsp/roomcorr.yaml"

# The PCM names defined in /etc/asound.conf.  `dsp96` runs through CamillaDSP,
# `ldac96` goes straight to the card.
PCM_DSP = "dsp96"
PCM_DIRECT = "ldac96"

MAC_RE = re.compile(r"^([0-9A-F]{2}:){5}[0-9A-F]{2}$")
SERVICES = ("bluetooth", "bluealsa", "bluealsa-aplay", "bt-agent", "ldac-web",
            "ldac-single-link")

# How often watch-single-link looks at the adapter.  Two seconds is well under
# the time it takes anyone to notice a second device connecting, and each pass
# is two short commands.
SINGLE_LINK_POLL_SECONDS = 2.0

# The interface's own output attenuator, the same element BlueALSA would drive
# if it were in mixer mode.  On the UMC404HD it is 128 steps of exactly 1 dB
# from 0 down to -127 dB, so it is presented and set in dB rather than as a
# percentage: 50% of the raw range would be -63 dB, which is silence.
MIXER_CONTROL = os.environ.get("LDAC_MIXER_CONTROL", "UMC404HD 192k Output")
# How far down the panel's slider goes.  Everything below is inaudible anyway,
# and mute is a separate button.
VOLUME_FLOOR_DB = -80.0

# Who drives that control, as bluealsa-aplay's --volume argument.  "mixer" hands
# it to the connected device; "software" keeps it for the panel and applies the
# device's volume digitally instead.
VOLUME_MODE_PANEL = "software"
VOLUME_MODE_DEVICE = "mixer"


def run(argv, timeout=15):
    """Run a command with no shell, returning (rc, stdout). Never raises.

    input="" matters more than it looks.  btmgmt is built on BlueZ's bt_shell,
    which produces *no output at all* — exit status 0, empty stdout — when its
    stdin is /dev/null, and /dev/null is exactly what systemd hands a service.
    Every btmgmt call from a unit therefore came back blank, which read as "the
    adapter has no flags set" rather than as a failure.  Passing input= gives
    the child a pipe that closes immediately, which bt_shell is happy with.
    """
    try:
        p = subprocess.run(argv, capture_output=True, text=True,
                           input="", timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.SubprocessError):
        return -1, ""


def read_defaults():
    values = {}
    try:
        with open(DEFAULTS) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip('"')
    except OSError:
        pass
    return values


def write_defaults(updates):
    """Rewrite the defaults file, preserving comments and key order."""
    lines, seen = [], set()
    try:
        with open(DEFAULTS) as fh:
            for line in fh:
                stripped = line.strip()
                if stripped and not stripped.startswith("#") and "=" in stripped:
                    key = stripped.split("=", 1)[0].strip()
                    if key in updates:
                        lines.append("%s=%s\n" % (key, updates[key]))
                        seen.add(key)
                        continue
                lines.append(line)
    except OSError:
        pass
    for key, value in updates.items():
        if key not in seen:
            lines.append("%s=%s\n" % (key, value))

    # Atomic replace: a half-written defaults file would take the audio path
    # down on the next restart.
    directory = os.path.dirname(DEFAULTS)
    fd, tmp = tempfile.mkstemp(dir=directory)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.writelines(lines)
        os.chmod(tmp, 0o644)
        os.replace(tmp, DEFAULTS)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def adapter_path():
    try:
        for name in sorted(os.listdir(BLUETOOTH_STATE)):
            if MAC_RE.match(name.upper()):
                return os.path.join(BLUETOOTH_STATE, name)
    except OSError:
        pass
    return None


def connected_macs():
    """Active ACL links, from a single hcitool call."""
    _, out = run(["hcitool", "con"])
    return {m.upper() for m in re.findall(r"ACL ((?:[0-9A-F]{2}:){5}[0-9A-F]{2})",
                                          out, re.I)}


def paired_devices():
    """Bonded devices, read from BlueZ's own state directory.

    Cheaper and more reliable than asking bluetoothctl device by device: a
    directory with an `info` file is exactly a stored bond.
    """
    base = adapter_path()
    if base is None:
        return []
    live = connected_macs()
    devices = []
    try:
        entries = sorted(os.listdir(base))
    except OSError:
        return []
    for name in entries:
        mac = name.upper()
        if not MAC_RE.match(mac):
            continue
        info = os.path.join(base, name, "info")
        if not os.path.exists(info):
            continue          # cache entry, never bonded
        friendly, trusted, blocked, klass = mac, False, False, None
        try:
            with open(info, errors="replace") as fh:
                for line in fh:
                    line = line.strip()
                    if line.startswith("Name="):
                        friendly = line[5:]
                    elif line.startswith("Trusted="):
                        trusted = line[8:].lower() == "true"
                    elif line.startswith("Blocked="):
                        blocked = line[8:].lower() == "true"
                    elif line.startswith("Class="):
                        klass = line[6:]
        except OSError:
            pass
        devices.append({
            "mac": mac,
            "name": friendly,
            "trusted": trusted,
            "blocked": blocked,
            "class": klass,
            "connected": mac in live,
        })
    return devices


def single_link_active():
    rc, out = run(["systemctl", "is-active", "ldac-single-link"])
    return out.strip() == "active"


def apply_link_gate():
    """Make the adapter reachable only when no device is connected.

    A device already paired is not stopped from *reconnecting* by anything in
    BlueZ — there is no "maximum connections" setting — so the only way to hold
    the box to one device is to stop advertising and stop accepting connections
    while one is in use, and put both back when it leaves.

    Written as "work out what the state should be, then fix what differs" rather
    than "act on transitions", so it repairs itself if something else changes
    the adapter behind our back, and does nothing at all in the steady state.

    Returns the address being kept, or None.
    """
    live = connected_macs()
    # Deterministic choice if two arrive together; the loser is disconnected
    # below and can come back once the winner leaves.
    primary = sorted(live)[0] if live else None

    for mac in sorted(m for m in live if m != primary):
        run(["bluetoothctl", "disconnect", mac], timeout=20)

    want_connectable = primary is None
    want_discoverable = (primary is None and
                         read_defaults().get("LDAC_DISCOVERABLE", "on") == "on")

    # adapter_flags(), not adapter_state(): the latter reports whether *this*
    # service is active, which means shelling out to systemctl about the unit
    # the loop is running inside.  That is fine for a one-shot status call and
    # much too slow to do on every pass of a control loop.
    flags = adapter_flags()
    if not flags:
        # The adapter state could not be read.  Setting it anyway is harmless
        # and idempotent; treating "no flags" as "nothing needs changing" is
        # how this silently did nothing for a while.
        run(["btmgmt", "connectable", "on" if want_connectable else "off"])
        run(["btmgmt", "discov", "on" if want_discoverable else "off"])
        return primary
    if ("connectable" in flags) != want_connectable:
        run(["btmgmt", "connectable", "on" if want_connectable else "off"])
    if ("discoverable" in flags) != want_discoverable:
        run(["btmgmt", "discov", "on" if want_discoverable else "off"])
    return primary


def cmd_watch_single_link():
    stopping = {"now": False}

    def stop(_signum, _frame):
        stopping["now"] = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    while not stopping["now"]:
        apply_link_gate()
        time.sleep(SINGLE_LINK_POLL_SECONDS)

    # Leave the adapter reachable on the way out, or stopping this service would
    # quietly leave the box unable to accept any connection at all.
    run(["btmgmt", "connectable", "on"])
    if read_defaults().get("LDAC_DISCOVERABLE", "on") == "on":
        run(["btmgmt", "discov", "on"])
    return {"ok": True}


def adapter_info():
    """Raw `btmgmt info` output, plus the current-settings flags."""
    _, out = run(["btmgmt", "info"])
    settings = ""
    for line in out.splitlines():
        if "current settings:" in line:
            settings = line.split("current settings:", 1)[1]
            break
    return out, settings.split()


def adapter_flags():
    return adapter_info()[1]


def adapter_state():
    out, flags = adapter_info()
    addr = re.search(r"addr ((?:[0-9A-F]{2}:){5}[0-9A-F]{2})", out, re.I)
    name = re.search(r"^\s*name (.+)$", out, re.M)
    return {
        "address": addr.group(1).upper() if addr else None,
        "name": name.group(1).strip() if name else None,
        "powered": "powered" in flags,
        # The live radio state ...
        "discoverable": "discoverable" in flags,
        "bondable": "bondable" in flags,
        "connectable": "connectable" in flags,
        # ... and what was actually asked for, which differ while the box is
        # holding itself closed for a connected device.  The panel shows the
        # setting, so its switch does not appear to flip on its own.
        "discoverable_setting": read_defaults().get("LDAC_DISCOVERABLE", "on") == "on",
        "single_link": single_link_active(),
        "occupied": bool(connected_macs()),
    }


def stream_state():
    """The A2DP stream BlueALSA currently has, if any."""
    rc, out = run(["bluealsactl", "list-pcms"])
    path = next((p for p in out.split() if p.startswith("/org/bluealsa/")), None)
    if rc != 0 or path is None:
        return {"connected": False}
    _, info = run(["bluealsactl", "info", path])
    fields = {}
    for line in info.splitlines():
        key, _, value = line.partition(":")
        if value:
            fields[key.strip().lower()] = value.strip()
    rate = re.match(r"(\d+)", fields.get("rate", ""))
    return {
        "connected": True,
        "codec": fields.get("selected codec"),
        "available": (fields.get("available codecs") or "").split(),
        "rate": int(rate.group(1)) if rate else None,
        "format": fields.get("format"),
        "channels": fields.get("channels"),
        "running": fields.get("running", "").lower() == "true",
    }


def card_state():
    """What the sound card is really doing, straight from ALSA.

    /proc/asound has a symlink named after the card id pointing at cardN, so the
    id can be used as a path component directly.
    """
    params = "/proc/asound/%s/pcm0p/sub0/hw_params" % CARD
    try:
        with open(params) as fh:
            text = fh.read()
    except OSError:
        return {"open": False, "error": "card %s not found" % CARD}
    if "closed" in text:
        return {"open": False}
    out = {"open": True}
    for line in text.splitlines():
        key, _, value = line.partition(":")
        key, value = key.strip(), value.strip()
        if key == "rate":
            out["rate"] = int(value.split()[0])
        elif key in ("format", "channels"):
            out[key] = value
    return out


def volume_state():
    """The interface's hardware output level.

    Read from the first playback channel; the element covers all four outputs
    and they are always set together.
    """
    mode = read_defaults().get("LDAC_VOLUME_MODE", VOLUME_MODE_PANEL)
    source = "device" if mode == VOLUME_MODE_DEVICE else "panel"

    rc, out = run(["amixer", "-c", CARD, "sget", MIXER_CONTROL])
    if rc != 0:
        return {"available": False, "source": source,
                "error": "no '%s' control on card %s" % (MIXER_CONTROL, CARD)}
    m = re.search(r"Playback (\d+) \[(\d+)%\] \[(-?[\d.]+)dB\] \[(on|off)\]", out)
    if not m:
        # Some controls have no dB scale; without one a dB slider is meaningless.
        return {"available": False, "source": source,
                "error": "control has no dB scale"}
    return {
        "available": True,
        "control": MIXER_CONTROL,
        "raw": int(m.group(1)),
        "percent": int(m.group(2)),
        "db": float(m.group(3)),
        "muted": m.group(4) == "off",
        "floor_db": VOLUME_FLOOR_DB,
        "source": source,
    }


# alsactl lives in /usr/sbin, which is not on every caller's PATH.
ALSACTL = next((p for p in ("/usr/sbin/alsactl", "/sbin/alsactl",
                            "/usr/bin/alsactl") if os.path.exists(p)), None)


def store_mixer():
    """Persist the mixer immediately.  Returns whether it worked.

    alsa-restore.service puts the mixer back at boot from a file it only writes
    on a clean shutdown, so without this a level set here would be lost on a
    power cut — and the card comes back at 0 dB, which is full output.

    --no-lock: alsactl's lock file lives in /var/lock, which is read-only inside
    the control panel's mount namespace, so locking cannot work there; worse, an
    interrupted run leaves the lock behind and every later store fails with
    "File exists" until someone deletes it by hand.  Nothing else writes this
    state except alsa-restore at boot and shutdown, so the lock buys nothing
    here and costs a silent failure mode.
    """
    if ALSACTL is None:
        return False
    rc, _ = run([ALSACTL, "--no-lock", "store", CARD])
    return rc == 0


def cmd_volume(action, value):
    if action == "source":
        if value not in ("panel", "device"):
            fail("volume source must be 'panel' or 'device', got %r" % value)
        write_defaults({"LDAC_VOLUME_MODE": VOLUME_MODE_DEVICE if value == "device"
                        else VOLUME_MODE_PANEL})
        # bluealsa-aplay reads --volume once at start, so the change lands on
        # restart.  This interrupts anything playing, as with the DSP toggle.
        rc, _ = run(["systemctl", "restart", "bluealsa-aplay"], timeout=30)
        if rc != 0:
            fail("could not restart bluealsa-aplay")
        return {"ok": True, "volume": volume_state()}

    if action == "mute":
        on = want_on(value)
        rc, _ = run(["amixer", "-c", CARD, "-q", "sset", MIXER_CONTROL,
                     "off" if on else "on"])
        if rc != 0:
            fail("could not change mute")
        return {"ok": True, "persisted": store_mixer(), "volume": volume_state()}

    if action != "set":
        fail("unknown volume action: %r" % action)

    try:
        db = float(value)
    except ValueError:
        fail("volume must be a number of dB, got %r" % value)
    if db != db or db in (float("inf"), float("-inf")):
        fail("volume must be a real number of dB")
    # Never above unity: this is an attenuator, and the card would clamp anyway.
    db = max(-127.0, min(0.0, db))
    # `--` so a negative value is not taken for an option.
    rc, _ = run(["amixer", "-c", CARD, "-q", "--", "sset", MIXER_CONTROL,
                 "%.0fdB" % db])
    if rc != 0:
        fail("could not set volume")
    # Reported rather than swallowed: if this is false the level is live but
    # will not survive a reboot, which is worth knowing.
    return {"ok": True, "persisted": store_mixer(), "volume": volume_state()}


def camilladsp_state():
    rc, out = run(["pgrep", "-a", "camilladsp"])
    if rc != 0 or not out.strip():
        return {"running": False}
    pid = out.split()[0]
    _, cpu = run(["ps", "-o", "pcpu=", "-p", pid])
    try:
        load = float(cpu.strip())
    except ValueError:
        load = None
    return {"running": True, "pid": int(pid), "cpu": load}


def convolution_state():
    pcm = read_defaults().get("LDAC_PCM", PCM_DSP)
    state = {"enabled": pcm == PCM_DSP, "pcm": pcm}
    # Name the filter actually configured, rather than assuming.
    try:
        with open(CDSP_CONFIG) as fh:
            found = re.findall(r"filename:\s*(\S+)", fh.read())
        if found:
            state["filter"] = os.path.basename(found[0].strip('"\''))
    except OSError:
        pass
    state.update(camilladsp_state())
    return state


def services_state():
    out = {}
    for unit in SERVICES:
        rc, text = run(["systemctl", "is-active", unit])
        out[unit] = text.strip() or "unknown"
    return out


def cmd_status():
    return {
        "convolution": convolution_state(),
        "adapter": adapter_state(),
        "stream": stream_state(),
        "card": card_state(),
        "volume": volume_state(),
        "services": services_state(),
        "devices": paired_devices(),
    }


def want_on(word):
    if word not in ("on", "off"):
        fail("expected 'on' or 'off', got %r" % word)
    return word == "on"


def cmd_convolution(word):
    on = want_on(word)
    write_defaults({"LDAC_PCM": PCM_DSP if on else PCM_DIRECT})
    # bluealsa-aplay picks the PCM up from the defaults file at start, so the
    # change takes effect on restart.  This interrupts anything playing.
    rc, _ = run(["systemctl", "restart", "bluealsa-aplay"], timeout=30)
    if rc != 0:
        fail("could not restart bluealsa-aplay")
    return {"ok": True, "convolution": convolution_state()}


def cmd_discoverable(word):
    on = want_on(word)
    write_defaults({"LDAC_DISCOVERABLE": "on" if on else "off"})
    if single_link_active():
        # Let the gate decide: with a device connected the setting is saved but
        # the radio stays closed until it leaves.
        apply_link_gate()
    else:
        rc, _ = run(["btmgmt", "discov", "on" if on else "off"])
        if rc != 0:
            fail("btmgmt discov failed")
    return {"ok": True, "adapter": adapter_state()}


def cmd_device(action, mac):
    mac = mac.upper()
    if not MAC_RE.match(mac):
        fail("not a Bluetooth address: %r" % mac)
    # bluetoothctl exits 0 even when the operation failed, so each action is
    # judged on what it printed rather than on the exit status.
    success_marker = {
        "connect": ("connection successful", "already connected"),
        "disconnect": ("successful disconnected", "not connected"),
        "trust": ("trust succeeded",),
        "untrust": ("untrust succeeded",),
        "remove": ("has been removed",),
    }
    if action not in success_marker:
        fail("unknown device action: %r" % action)
    # `connect` can sit for a while on this adapter, and often needs a retry.
    rc, out = run(["bluetoothctl", action, mac],
                  timeout=45 if action == "connect" else 20)
    lowered = out.lower()
    ok = rc != -1 and any(m in lowered for m in success_marker[action])
    last = [ln for ln in out.strip().splitlines() if ln.strip()]
    return {"ok": ok, "message": last[-1] if last else "",
            "devices": paired_devices()}


def cmd_apply_boot():
    """Put the adapter into the state the panel last asked for."""
    values = read_defaults()
    run(["btmgmt", "power", "on"])
    run(["btmgmt", "connectable", "on"])
    run(["btmgmt", "bondable", "on"])
    discoverable = values.get("LDAC_DISCOVERABLE", "on")
    run(["btmgmt", "discov", "on" if discoverable == "on" else "off"])
    return {"ok": True, "adapter": adapter_state()}


def fail(message):
    json.dump({"ok": False, "error": message}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(2)


def main(argv):
    if not argv:
        fail("no verb given")
    verb, args = argv[0], argv[1:]
    if verb == "status" and not args:
        result = cmd_status()
    elif verb == "convolution" and len(args) == 1:
        result = cmd_convolution(args[0])
    elif verb == "discoverable" and len(args) == 1:
        result = cmd_discoverable(args[0])
    elif verb == "volume" and len(args) == 2:
        result = cmd_volume(args[0], args[1])
    elif verb == "device" and len(args) == 2:
        result = cmd_device(args[0], args[1])
    elif verb == "apply-boot" and not args:
        result = cmd_apply_boot()
    elif verb == "watch-single-link" and not args:
        result = cmd_watch_single_link()
    else:
        fail("unknown verb or wrong number of arguments: %r" % (argv,))
    json.dump(result, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main(sys.argv[1:])
