# Runtime state for the LDAC receiver, installed as /etc/default/ldac-receiver.
#
# The web control panel rewrites this file through /usr/local/sbin/ldac-ctl and
# it is read back by bluealsa-aplay.service (as an EnvironmentFile) and by
# bluetooth-sink-setup.service at boot.  Editing it by hand works too; run
# `systemctl restart bluealsa-aplay` afterwards for LDAC_PCM to take effect.

# Which ALSA PCM from /etc/asound.conf receives the decoded Bluetooth audio:
#   dsp96  - through CamillaDSP room correction (default)
#   ldac96 - straight to the interface, correction bypassed
LDAC_PCM=dsp96

# Whether the adapter is discoverable, restored at boot. Pairing also requires
# it; leaving it off makes the box invisible to devices that are not already
# bonded.
LDAC_DISCOVERABLE=on

# Who drives the audio interface's own volume control:
#   software - the control panel's slider owns it, and the connected device's
#              volume is applied digitally instead (default)
#   mixer    - the connected device's volume sets the interface level directly.
#              Nothing then scales the samples anywhere, but the device will
#              overwrite whatever the slider was set to.
LDAC_VOLUME_MODE=software

# Which input feeds the interface:
#   bluetooth - A2DP from a phone or computer, via bluealsa-aplay (default)
#   usb       - the USB Audio Class gadget, via ldac-usb-dac
#
# These are alternatives, not a mix: CamillaDSP opens the interface
# exclusively, so only one player can hold it. Switching stops the other one,
# which interrupts whatever was playing. Room correction (LDAC_PCM above)
# applies to both.
LDAC_SOURCE=bluetooth

# Whether to hand power back to whatever is plugged into USB-C2, so a phone
# charges while it plays into the DAC. Done with a Power Delivery PR_SWAP, so it
# needs the charging overlay (config/cubie-a7s-usbc2-device-charge.dts) and a
# partner that speaks PD; a plain 5 V OTG source offers no contract to swap
# inside and the request is declined. What the board offers is fixed in that
# overlay's source-pdos, currently 5 V at 500 mA.
LDAC_USB_CHARGE=on

# USB DAC latency/robustness trade. CamillaDSP sizes the ALSA buffers from this:
# the interface's buffer is 4x it and is held half full, so 2048 frames at
# 96 kHz is ~21 ms of chunk plus ~43 ms of fill. Halving it halves that and
# doubles how often the uncorrected clock drift empties the buffer (one tick).
# 1024 is the sensible floor. Restart ldac-usb-dac to apply.
LDAC_CHUNKSIZE=2048

# --- amplifier relay -------------------------------------------------------
# Switch a power amplifier with a relay on the 30-pin header: on as soon as a
# device connects (USB host enumerated, or any Bluetooth link), off once
# nothing has been connected for LDAC_AMP_OFF_DELAY seconds.
LDAC_AMP=on

# Which header pin drives the relay. The kernel names these lines after the
# physical pin, so PIN_26 is pin 26 (PD14) regardless of bank numbering; a raw
# "gpiochip0 110" also works. Pin 26 is chosen because it is the only free
# header pin that reads LOW when nothing drives it, so an active-high relay
# board stays off through boot and while this service is not running.
LDAC_AMP_PIN=PIN_26

# Set to "on" for the common opto-isolated relay boards whose input is pulled
# up and energises when driven low. With "off" the relay energises on a high.
LDAC_AMP_ACTIVE_LOW=off

# Seconds with nothing connected before the amplifier is switched off. Long
# enough to ride over a track change, a brief unplug, or a phone dropping and
# re-pairing.
LDAC_AMP_OFF_DELAY=60
