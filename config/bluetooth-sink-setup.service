# Installed as /etc/systemd/system/bluetooth-sink-setup.service
#
# BlueZ powers the adapter up from main.conf, but "discoverable" and "pairable"
# are runtime properties set over D-Bus, not settings in main.conf, and BlueZ
# 5.55 has no option to make them stick across a restart.  This puts them back
# after bluetoothd starts so the box can always be found and paired with.
#
# btmgmt talks to the kernel's management socket directly, which works headless;
# bluetoothctl would need an interactive session.

[Unit]
Description=Make the Bluetooth adapter discoverable and pairable (A2DP sink)
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/btmgmt power on
ExecStart=/usr/bin/btmgmt connectable on
ExecStart=/usr/bin/btmgmt bondable on
ExecStart=/usr/bin/btmgmt discov on

[Install]
WantedBy=bluetooth.target
