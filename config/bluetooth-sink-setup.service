# Installed as /etc/systemd/system/bluetooth-sink-setup.service
#
# BlueZ powers the adapter up from main.conf, but "discoverable", "connectable"
# and "bondable" are runtime properties set over D-Bus or the management socket,
# not settings in main.conf, and BlueZ 5.55 has no option to make them stick
# across a restart.  This puts them back after bluetoothd starts, using the
# discoverable state the web panel last saved in /etc/default/ldac-receiver.
#
# ldac-ctl talks to the kernel's management socket via btmgmt, which works
# headless; bluetoothctl would need an interactive session.

[Unit]
Description=Restore Bluetooth adapter state for the A2DP sink
After=bluetooth.service
Requires=bluetooth.service
# apply-boot also re-pins the recorder tap (outputs 3-4) to unity, which
# alsa-restore would otherwise overwrite from its saved state a moment later.
# Ordering only: if alsa-restore is absent or fails there is nothing to undo.
After=alsa-restore.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ldac-ctl apply-boot

[Install]
WantedBy=bluetooth.target
